{
  "name": "gitdesk",
  "version": "1.0.1",
  "description": "A free, open-source desktop Git client",
  "main": "./out/main/index.js",
  "author": {
    "name": "THELIOS CAPITAL",
    "url": "https://github.com/TheliosGroupe"
  },
  "license": "MIT",
  "homepage": "https://github.com/TheliosGroupe/GitDesk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheliosGroupe/GitDesk.git"
  },
  "bugs": {
    "url": "https://github.com/TheliosGroupe/GitDesk/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm run notices && electron-vite build",
    "notices": "node scripts/third-party-notices.mjs",
    "postinstall": "install-electron && node scripts/fix-node-pty.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test:e2e": "electron-vite build && node tests/e2e.mjs && node tests/e2e-features.mjs && node tests/e2e-layout.mjs && node tests/e2e-security.mjs",
    "test:e2e:github": "electron-vite build && node tests/e2e-github.mjs",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.57.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^3.2.7"
  }
}
